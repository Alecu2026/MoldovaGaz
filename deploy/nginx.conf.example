# Exemplu nginx în fața aplicației (HTTPS recomandat: cookie-ul de sesiune e Secure în producție).
server {
    listen 80;
    server_name EXEMPLU.md;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name EXEMPLU.md;
    # ssl_certificate / ssl_certificate_key (ex. certbot)

    client_max_body_size 25m;          # /api/ingest acceptă până la 20 MB per cerere

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;   # limitarea încercărilor de login folosește IP-ul real
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;            # tokenul pentru /api/ingest trebuie să ajungă la aplicație
    }
}

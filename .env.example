# Copiază în .env.local pe server (cp .env.example .env.local) și completează. .env.local NU se comite.

# Conexiunea MongoDB (baza aplicației: users, sessions, meters)
DATABASE_URL="mongodb://USER:PAROLA@HOST:27017/NUME_BAZA?authSource=admin"

# SCADA (ThingsBoard): lista contoarelor + valorile curente (Volume_m3_Total, Volume_m3_Total_ts, coordonate…) și istoricul. Folosește un cont cu drepturi DOAR de citire.
TB_USER=""
TB_PASS=""
# OBLIGATORIU (fără valoare implicită: fără el nu pleacă nicio cerere). De pe serverul din rețeaua locală: adresa internă, fără ieșire pe internet.
TB_URL=http://192.168.77.24:8080
# Pauza (ms) dintre două cereri către SCADA în timpul sincronizării (implicit 150): ține încărcarea serverului SCADA blândă.
# TB_PAUSE_MS=150

# Sursele din LAN pentru paginile „Dispozitive LoRaWAN” și „Facturare” (valorile implicite de mai jos)
# LORAWAN_DB_URL=http://192.168.77.11:3880/lorawandb
# MG_DB_URL=http://192.168.77.11:3880/getmgdb

# Portul și numele procesului pm2 (le citește ecosystem.config.js; Next nu citește PORT din .env.local). Pe un server cu alte proiecte alege un port liber.
PORT=3000
# PM2_NAME=moldovagaz

# Cookie-ul de sesiune e `Secure` doar când cererea vine pe HTTPS (se detectează singur). Forțare fără Secure, rar necesară:
# INSECURE_COOKIES=1

# Opțional: DNS de rezervă pentru mongodb+srv când resolverul serverului refuză interogările SRV
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8

# Opțional: numele colecțiilor (implicit users, sessions, meters)
# METERS_COLLECTION=meters

# Integrare (POST /api/integration): token pentru expeditorii de mesaje (LoRaWAN / antene), minimum 24 de caractere; fără el integrarea e dezactivată.
# Generează unul nou:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# INTEGRATION_TOKEN=
# Câte mesaje încap în cutia de intrare înainte să răspundă 503 (implicit 500000)
# INTEGRATION_MAX_INBOX=500000

# Raportul de citiri către facturare (Oracle): directorul în care se scrie fișierul CSV (lângă el apare și .sha256). Poate fi un director montat din rețea.
# Implicit: directorul „reports/” de lângă aplicație. Raportul automat rulează pe 1 ale lunii la 07:00 (pm2, aplicația „<nume>-report”).
# REPORT_OUT_DIR=/mnt/facturare/citiri
# Raportul automat: toate citirile (all), una pe zi (daily) sau doar ultima (last); și dacă include doar contoarele legate de facturare (implicit da; 0 = toate)
# REPORT_MODE=all
# REPORT_ONLY_BILLED=1

# Pozele contoarelor (atributul `image` din SCADA): se extrag, se micșorează și se scriu pe disc. Pornește DOAR cu PHOTO_PULL=1 (pm2 „<nume>-photos”, zilnic la 22:00, reluabil).
# PHOTO_PULL=1
# PHOTO_DIR=/var/www/poze-contoare   # implicit directorul „photos/” de lângă aplicație (~6–7 GB pentru toate contoarele)
# PHOTO_MAX_PX=1600        # latura lungă a pozei păstrate
# PHOTO_CONCURRENCY=3      # cereri deodată către SCADA
# PHOTO_PAUSE_MS=150       # pauză între cereri, la fiecare
# PHOTO_MIN_FREE_GB=3      # se oprește dacă pe disc rămân mai puțin
# PHOTO_LIMIT=200          # test: doar primele N contoare

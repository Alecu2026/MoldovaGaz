# Copiază în .env.local pe server (cp .env.example .env.local) și completează. .env.local NU se comite.

# Conexiunea MongoDB (baza moldovagaz)
DATABASE_URL="mongodb+srv://USER:PAROLA@CLUSTER.mongodb.net/moldovagaz?retryWrites=true&w=majority"

# Secretul pentru POST /api/ingest (ChirpStack trimite: Authorization: Bearer <token>).
# Generează unul:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
INGEST_TOKEN=""

# Portul și numele procesului pm2 (le citește ecosystem.config.js; Next nu citește PORT din .env.local). Pe un server cu alte proiecte alege un port liber.
PORT=3000
# PM2_NAME=moldovagaz

# Doar dacă accesezi aplicația pe HTTP simplu (fără HTTPS). Cu HTTPS lasă comentat:
# cookie-ul de sesiune e `Secure` în producție și nu se salvează pe HTTP.
# INSECURE_COOKIES=1

# Opțional: fereastra de date ținută în memoria serverului
# UPLINK_WINDOW_DAYS=30
# UPLINK_MAX_ROWS=300000

# Opțional: DNS de rezervă pentru mongodb+srv când resolverul serverului refuză interogările SRV
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
